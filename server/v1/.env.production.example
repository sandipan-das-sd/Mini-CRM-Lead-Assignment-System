NODE_ENV=production
PORT=4000

# Docker service credentials. Generate both passwords with: openssl rand -hex 32
DB_NAME=lead_assignment
DB_USER=lead_app
DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_ROOT_PASSWORD
DB_CONNECTION_LIMIT=20
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD

# Generate with: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_HEX_64
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12

CORS_ORIGIN=https://crm.sandipandas.website
TRUST_PROXY=true
APP_URL=https://crm.sandipandas.website

LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
DASHBOARD_CACHE_TTL_SECONDS=60

# Replace with credentials supplied by your SMTP provider.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM=LeadFlow CRM <no-reply@sandipandas.website>

# Used only by the one-time seed command. Change/remove after initial seed.
ADMIN_NAME=Sandipan Das
ADMIN_EMAIL=admin@sandipandas.website
ADMIN_PASSWORD=REPLACE_WITH_STRONG_INITIAL_ADMIN_PASSWORD

{
  "name": "v1",
  "version": "1.0.0",
  "description": "Production-oriented Mini CRM API",
  "main": "server.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:seed:demo": "node scripts/seed-demo.js",
    "worker:notifications": "node workers/notification.worker.js",
    "test": "node --test --test-concurrency=1 tests/unit/*.test.js tests/integration/auth.test.js tests/integration/authorization.test.js",
    "test:db": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "test:docker": "docker compose -f compose.test.yaml up --build --abort-on-container-exit --exit-code-from test",
    "test:docker:down": "docker compose -f compose.test.yaml down -v --remove-orphans",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "bullmq": "^6.3.12",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.15.3",
    "nodemailer": "^10.1.0",
    "redis": "^6.3.0",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
